    "build": "python3 scripts/build.py && python3 scripts/check-site.py",
    "generate": "python3 scripts/generate.py"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "axe-core": "4.11.1",
    "lighthouse": "13.0.1"
  }
}
